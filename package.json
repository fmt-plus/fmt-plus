{
  "name": "fmt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "trench": {
    "name": "fmt+",
    "slug": "fmt",
    "domain": "fmt.plus",
    "template": "app",
    "webPort": 5530,
    "apiPort": 5531
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "server": "node --disable-warning=ExperimentalWarning --watch-path=server server/main.mjs",
    "start": "STATIC_DIR=dist node --disable-warning=ExperimentalWarning server/main.mjs",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "copy": "node scripts/copycheck.mjs src/copy.ts",
    "numbers": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-numbers.mjs",
    "labels": "node scripts/check-labels.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test 'server/test/*.test.mjs'",
    "check": "npm run copy && npm run numbers && npm run typecheck && npm test",
    "shots": "node scripts/shots.mjs",
    "assets": "node scripts/assets.mjs",
    "diagrams": "node scripts/diagrams.mjs",
    "brand": "node scripts/brand.mjs",
    "release": "bash deploy/release.sh",
    "tg": "node scripts/tg.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/instrument-serif": "^5.2.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright-core": "1.56.1",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  },
  "description": "Every trench tool. One agent. Yours."
}
